{
  "name": "jrc-rodeo",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild js/app.js --bundle=false --minify --outfile=js/app.js && esbuild css/app.css --bundle=false --minify --log-level=silent --outfile=css/app.css",
    "build:js": "esbuild js/app.js --bundle=false --minify --outfile=js/app.js",
    "build:css": "esbuild css/app.css --bundle=false --minify --log-level=silent --outfile=css/app.css"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
